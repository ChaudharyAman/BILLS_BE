# ==============================================================================
# Flance Backend Configuration Template (.env.example)
# IMPORTANT: Never commit actual secret values. Copy this file to .env and fill in values.
# ==============================================================================

# Server Configuration
PORT=5001
NODE_ENV=development

# Database Connection (MongoDB)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/mybill

# Authentication & JWT Secrets
# MANDATORY: JWT_SECRET must be at least 32 characters long. The server will fail fast on startup if shorter.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long
JWT_EXPIRES_IN=24h

# Cookie & Session Security
# Set to 'true' in production / when behind HTTPS. Set to 'false' for local HTTP development.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_ALLOW_HTTP=true

# Data Encryption at Rest (PII fields: PAN, Aadhaar, Bank Details)
# MANDATORY in production for AES-256-GCM encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_SECRET_KEY=replace_with_64_hex_character_key_generated_via_crypto_randomBytes

# Master User / Switcher Tool (Superadmin impersonation / diagnostics)
# Master user is disabled if MASTER_USER_PASSWORD is missing or weak (< 12 chars, upper, lower, number, special).
MASTER_USER_EMAIL=master@flance.in
MASTER_USER_NAME=System Master
MASTER_USER_PASSWORD=replace_with_a_strong_master_password_at_least_12_characters_with_symbols

# Frontend Client URL (for CORS and email callback links)
CLIENT_URL=http://localhost:5173

# Cloud Storage (Cloudinary - Document and Invoice Attachments)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI & Document Intelligence (NVIDIA NIM & Docling)
NVIDIA_API_KEY=your_nvidia_nim_api_key
NVIDIA_INVOICE_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_INVOICE_TIMEOUT_MS=60000
DOCLING_ENABLED=true
DOCLING_SERVICE_URL=http://localhost:8000
NVIDIA_INVOICE_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_INVOICE_VISION_TIMEOUT_MS=45000
NVIDIA_INVOICE_OCR_MAX_PAGES=3
NVIDIA_INVOICE_OCR_SCALE=2.0
NVIDIA_INVOICE_OCR_MAX_DIMENSION=2000
NVIDIA_INVOICE_TEXT_CHUNK_LINES=120
NVIDIA_INVOICE_TEXT_CHUNK_LIMIT=10
NVIDIA_INVOICE_TEXT_SINGLE_PASS_CHAR_LIMIT=20000

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Transactional Email (SMTP / Brevo / Sendgrid)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_SENDER=your_verified_sender@domain.com

# Google OAuth 2.0 (SSO Login)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Rate Limiting
API_RATE_LIMIT_MAX=1000
